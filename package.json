{
  "name": "ocp_quickstart_app",
  "version": "1.0.0-dev.1",
  "main": "dist/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "build": "yarn && npx rimraf remove dist && npx tsc && cpy app.yml dist && cpy --up 1 \"src/**/*.{yml,yaml}\" dist",
    "validate": "yarn build && yarn lint && yarn test && npx cross-env LOG_LEVEL=never node node_modules/@zaiusinc/app-sdk/dist/app/validation/runValidation.js",
    "lint": "npx eslint src",
    "test": "npx vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@zaiusinc/eslint-config-presets": "^3.0.0",
    "cpy-cli": "^6.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@azure/arm-eventgrid": "^14.1.0",
    "@azure/identity": "^3.2.2",
    "@azure/storage-blob": "^12.14.0",
    "@zaiusinc/app-sdk": "3.4.1",
    "@zaiusinc/node-sdk": "3.0.0"
  }
}
